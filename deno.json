{
    "tasks": {
        "start": "deno --allow-env --allow-read --allow-write --allow-net main.ts",
        "dev": "deno run --watch --allow-env --allow-read --allow-write=output --deny-net main.ts --dry-run",
        "test": "deno test --frozen --allow-read --allow-write --allow-env --deny-net",
        "check": "deno check --frozen main.ts test/*.test.ts tools/*.ts",
        "fmt": "deno fmt",
        "lint": "deno lint",
        "verify": "deno fmt --check && deno lint && deno task check && deno task test",
        "preview": "deno run --allow-env --allow-read --allow-write=output --deny-net main.ts --dry-run"
    },
    "imports": {
        "@libs/xml": "jsr:@libs/xml@^8.0.1",
        "@std/cli": "jsr:@std/cli@^1.0.32",
        "@std/expect": "jsr:@std/expect@^1.0.20",
        "@std/path": "jsr:@std/path@^1.1.6",
        "@std/text": "jsr:@std/text@^1.1.0",
        "@std/yaml": "jsr:@std/yaml@^1.3.0",
        "hast": "npm:@types/hast@^3.0.5",
        "hast-util-to-html": "npm:hast-util-to-html@^9.0.5",
        "hast-util-to-mdast": "npm:hast-util-to-mdast@^10.1.2",
        "mdast": "npm:@types/mdast@^4.0.4",
        "mdast-util-to-hast": "npm:mdast-util-to-hast@13.2.1",
        "rehype-parse": "npm:rehype-parse@^9.0.1",
        "rehype-remark": "npm:rehype-remark@^10.0.1",
        "remark-gfm": "npm:remark-gfm@^4.0.1",
        "remark-parse": "npm:remark-parse@^11.0.0",
        "remark-stringify": "npm:remark-stringify@^11.0.0",
        "unified": "npm:unified@^11.0.5"
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120,
        "singleQuote": true,
        "exclude": [
            ".agents/skills/"
        ]
    }
}
