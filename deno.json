{
    "tasks": {
        "start": "deno --allow-env --allow-read --allow-write --allow-net main.ts",
        "dev": "deno run --watch --allow-env --allow-read --deny-write --deny-net main.ts --dry-run",
        "test": "deno test --frozen --allow-read --allow-write --allow-env",
        "check": "deno check --frozen main.ts test/*.test.ts",
        "fmt": "deno fmt",
        "lint": "deno lint",
        "verify": "deno fmt --check && deno lint && deno task check && deno task test",
        "preview": "deno run --allow-env --allow-read --deny-write --deny-net main.ts --dry-run"
    },
    "imports": {
        "@libs/xml": "jsr:@libs/xml@^8.0.1",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/cli": "jsr:@std/cli@^1.0.32",
        "@std/path": "jsr:@std/path@^1.1.6",
        "@std/text": "jsr:@std/text@^1.1.0",
        "@std/yaml": "jsr:@std/yaml@^1.3.0",
        "cheerio": "npm:cheerio@^1.2.0"
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120,
        "singleQuote": true,
        "exclude": [
            ".agents/skills/"
        ]
    }
}
